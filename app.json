{
  "expo": {
    "name": "Classifica Basket",
    "slug": "classifica-basket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "classificabasket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phelouzat3.classificabasket",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "userInterfaceStyle": "automatic"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "userInterfaceStyle": "automatic",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.phelouzat3.classificabasket"
    },
    "web": {
      "name": "Classifica Basket",
      "shortName": "Basket",
      "description": "Classifica, calendario, risultati e statistiche dell'ABC Castelfiorentino - Serie C Maschile e Femminile",
      "lang": "it",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "388f4e06-e5ba-4155-9ac8-b3573d2700ad"
      }
    }
  }
}
